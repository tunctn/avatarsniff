// Generated by Project Doctor
{
  "$schema": "https://www.homemade.dev/schemas/latest/config.json",
  // Fill the pnpm store and build lib/dist once, so the site can start.
  "warmup": ["pnpm install --frozen-lockfile", "pnpm --filter avatarsniff build"],
  "install": ["pnpm install --frozen-lockfile"],
  "services": {
    // Rebuilds lib/dist on every change in lib/src; the site picks it up.
    "lib": {
      "cmd": "exec pnpm --filter avatarsniff dev",
      "healthcheck": { "cmd": "test -f lib/dist/index.js" },
      "displayName": "avatarsniff lib (watch)"
    },
    "site": {
      "cmd": "exec pnpm --filter avatarsniff-site exec next dev -H 0.0.0.0 -p $PORT",
      "depends_on": { "lib": { "condition": "healthy" } },
      "port": 3000,
      "url": true,
      "healthcheck": { "path": "/api/health" },
      "displayName": "Demo site"
    }
  }
}
